# Copie para .env.local e preencha. Tudo é opcional: sem as chaves do Supabase o
# site roda em MODO DE DEMONSTRAÇÃO (dados de exemplo).

# Supabase (banco de dados + login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: só no servidor (coleta de preços, job de alertas, visitas)
SUPABASE_SERVICE_ROLE_KEY=

# E-mails de alerta (Resend). Sem a chave, o envio é apenas simulado no console.
RESEND_API_KEY=
EMAIL_FROM="GarimpoPC <onboarding@resend.dev>"

# Segredo do job de alertas (/api/check-alerts)
CRON_SECRET=

# URL pública do site (usada nos links dos e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
